{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Bash(mvn -B -ntp verify)",
      "Bash(mvn verify)",
      "Bash(mvn test)",
      "Bash(mvn test *)",
      "Bash(mvn -Dskip.frontend=true test *)",
      "Bash(pnpm exec ng test *)",
      "Bash(pnpm test *)",
      "Bash(node scripts/agent-log-summary.mjs *)",
      "Bash(node scripts/hooks-selftest.mjs)",
      "Bash(node .claude/skills/agent-log-report/scripts/report.mjs *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(pnpm add *)",
      "Bash(pnpm install *)",
      "Edit(./pom.xml)",
      "Edit(./frontend/package.json)",
      "Edit(./.github/**)",
      "Edit(./.claude/settings.json)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-env.mjs"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/log-action.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/log-action.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/log-action.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
