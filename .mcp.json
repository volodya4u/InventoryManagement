{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CONTEXT7_API_KEY}"
      }
    },
    "angular-cli": {
      "type": "stdio",
      "command": "node",
      "args": ["scripts/ng-mcp.mjs"]
    }
  }
}
